# Sahana environment configuration.
#
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# All variables are prefixed with SAHANA_ and map onto the typed Settings object
# in apps/api/src/sahana_api/config.py. Provider keys below are placeholders:
# they are declared so the deployment surface is stable, but no code reads them
# yet. Leave them blank until the phase that consumes them.

# --- Core application ---
SAHANA_APP_NAME=Sahana
# One of: development | staging | production
SAHANA_APP_ENV=production

# --- Logging ---
# Standard Python level name: DEBUG | INFO | WARNING | ERROR | CRITICAL
SAHANA_LOG_LEVEL=INFO
# true renders JSON log lines (production); false renders a console format.
SAHANA_LOG_JSON=true

# --- HTTP server ---
SAHANA_API_HOST=0.0.0.0
SAHANA_API_PORT=8000
# JSON array of allowed CORS origins.
SAHANA_CORS_ALLOW_ORIGINS=["http://localhost:8080"]

# --- Database (Supabase Postgres) ---
# Two connection strings are required in staging/production. Both use the
# postgresql+asyncpg scheme.
#
# Runtime (pooled): the Supabase transaction pooler / pgbouncer (port 6543).
# The engine disables server-side prepared statements (statement_cache_size=0)
# because the transaction pooler is incompatible with them.
SAHANA_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Migrations (direct): a stable session for Alembic DDL. Use the direct
# connection (port 5432) or the session pooler, never the transaction pooler.
SAHANA_DATABASE_MIGRATION_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
#
# Connection pool sizing (SQLAlchemy). Defaults are sensible for a single api
# instance behind the pooler.
SAHANA_DB_POOL_SIZE=5
SAHANA_DB_MAX_OVERFLOW=10
SAHANA_DB_POOL_TIMEOUT=30
# Set true to echo SQL (development diagnostics only).
SAHANA_DB_ECHO=false

# --- Providers (declared for later phases; unused now) ---

# Supabase project references (used by later phases).
SAHANA_SUPABASE_URL=
SAHANA_SUPABASE_SERVICE_ROLE_KEY=

# Qdrant Cloud — vector store.
SAHANA_QDRANT_URL=
SAHANA_QDRANT_API_KEY=

# Groq — routing/classification LLMs (Llama family).
SAHANA_GROQ_API_KEY=

# OpenRouter — synthesis LLM (Gemini 2.5 Flash).
SAHANA_OPENROUTER_API_KEY=

# OpenAI — hosted embeddings.
SAHANA_OPENAI_API_KEY=

# Tavily — web search route.
SAHANA_TAVILY_API_KEY=
