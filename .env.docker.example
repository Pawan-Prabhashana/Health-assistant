# Sahana — Docker Compose environment.
#
# Copy this file to `.env` (which is gitignored) and fill in real values:
#   cp .env.docker.example .env
#
# Compose passes this whole file into the `api` and `ingest` containers
# (env_file). Every variable is prefixed SAHANA_ and maps onto the typed Settings
# object in apps/api/src/sahana_api/config.py.
#
# ── Minimum to boot ────────────────────────────────────────────────────────────
# NOTHING here is required for the stack to START and serve health: the api boots
# with liveness up, /health/ready reports dependencies as not-ready, and the SPA
# loads at http://localhost:8080. Leave every key blank and the containers still
# reach "healthy".
#
# ── Full functionality (which keys unlock what) ────────────────────────────────
#   Sessions, chat history, memory   → SAHANA_DATABASE_URL (+ _MIGRATION_URL for `make migrate`)
#   RAG knowledge base + CAG cache   → SAHANA_QDRANT_URL, SAHANA_QDRANT_API_KEY, SAHANA_OPENAI_API_KEY
#   Guardrail + router classifiers   → SAHANA_GROQ_API_KEY
#   Streamed synthesis reply         → SAHANA_OPENROUTER_API_KEY
#   Web-search route                 → SAHANA_TAVILY_API_KEY
# Set SAHANA_LLM_MODE=fake and SAHANA_TAVILY_MODE=fake to exercise the pipeline
# deterministically with no keys and no network.
#
# Legend: [required] must be set for that capability · [optional] has a safe
# default · [runtime] used by the running app · [migration] used only by Alembic.

# ── App config ─────────────────────────────────────────────────────────────────
SAHANA_APP_NAME=Sahana
# development | staging | production                                    [optional][runtime]
SAHANA_APP_ENV=production
# DEBUG | INFO | WARNING | ERROR | CRITICAL                              [optional][runtime]
SAHANA_LOG_LEVEL=INFO
# true renders JSON log lines (production); false a console format.      [optional][runtime]
SAHANA_LOG_JSON=true
# JSON array of allowed CORS origins. Behind nginx the browser is same-  [optional][runtime]
# origin, so this matters only for direct cross-origin API access.
SAHANA_CORS_ALLOW_ORIGINS=["http://localhost:8080"]

# ── Database (Supabase Postgres) ───────────────────────────────────────────────
# Runtime (pooled): Supabase transaction pooler / pgbouncer (port 6543).  [required][runtime]
# The engine disables server-side prepared statements (statement_cache_size=0),
# which the transaction pooler requires.
SAHANA_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations (direct): a stable session for Alembic DDL — direct (5432) [required][migration]
# or the session pooler, never the transaction pooler.
SAHANA_DATABASE_MIGRATION_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Connection pool sizing (see ADR 0014). Ceiling = pool_size + max_overflow = 15,
# which sustains ~5 concurrent chat requests (each peaks at 3 connections across
# the context fan-out) and matches the Supabase free-tier pooler pool. Raise both
# together with the pooler pool size for higher concurrency.            [optional][runtime]
SAHANA_DB_POOL_SIZE=5
SAHANA_DB_MAX_OVERFLOW=10
SAHANA_DB_POOL_TIMEOUT=30
# Echo SQL (development diagnostics only).                               [optional][runtime]
SAHANA_DB_ECHO=false

# ── Vector store (Qdrant Cloud) ────────────────────────────────────────────────
# Required for RAG and the CAG cache. When unset the app boots and qdrant   [required][runtime]
# reports not-ready.
SAHANA_QDRANT_URL=
SAHANA_QDRANT_API_KEY=
SAHANA_QDRANT_KB_COLLECTION=sahana_kb                                  # [optional][runtime]
SAHANA_QDRANT_CAG_COLLECTION=sahana_cag                                # [optional][runtime]

# ── Embeddings ─────────────────────────────────────────────────────────────────
# OpenAI powers KB retrieval quality; the local fastembed MiniLM powers the CAG
# cache with no per-lookup cost. The fastembed cache dir is fixed by compose to
# the hf_cache mount, so it is intentionally omitted here.
SAHANA_OPENAI_API_KEY=                                                 # [required][runtime]
SAHANA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small                   # [optional][runtime]
SAHANA_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2    # [optional][runtime]

# ── Knowledge base ─────────────────────────────────────────────────────────────
# kb_embedder: openai (production quality) | local (ingest/query without a key).
# Switching this changes the vector dimension; re-run ingest with --recreate.
SAHANA_KB_EMBEDDER=openai                                              # [optional][runtime]
SAHANA_KB_CHUNK_TOKENS=512                                             # [optional][runtime]
SAHANA_KB_CHUNK_OVERLAP=64                                             # [optional][runtime]

# ── CAG answer cache ───────────────────────────────────────────────────────────
# Route-gated KNN-1 cache. cacheable_routes excludes CRM so no patient-specific
# answer is ever cached.
SAHANA_CAG_SIMILARITY_THRESHOLD=0.92                                   # [optional][runtime]
SAHANA_CAG_TTL_SECONDS=86400                                           # [optional][runtime]
SAHANA_CAG_CACHEABLE_ROUTES=["rag","concierge","web_search"]          # [optional][runtime]

# ── Decision graph (see ADR 0010) ──────────────────────────────────────────────
SAHANA_ROUTER_MIN_CONFIDENCE=0.5                                       # [optional][runtime]
SAHANA_ROUTER_FALLBACK_ROUTE=direct                                   # [optional][runtime]
SAHANA_CAG_ROUTE_MATCH_POLICY=any_allowlisted                         # [optional][runtime]
SAHANA_REFUSAL_MESSAGE=I'm sorry, but I can only answer questions related to hospital services.

# ── LLM providers (single OpenAI-compatible transport; see ADR 0009) ───────────
# live (real providers) | fake (deterministic, no network/keys).
SAHANA_LLM_MODE=live                                                   # [optional][runtime]
# Groq powers the guardrail + router classifiers.
SAHANA_GROQ_API_KEY=                                                   # [required][runtime]
SAHANA_GROQ_BASE_URL=https://api.groq.com/openai/v1                    # [optional][runtime]
# OpenRouter powers the streamed synth reply.
SAHANA_OPENROUTER_API_KEY=                                             # [required][runtime]
SAHANA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1               # [optional][runtime]
SAHANA_OPENROUTER_REFERER=https://github.com/Pawan-Prabhashana/Health-assistant
SAHANA_OPENROUTER_TITLE=Sahana                                        # [optional][runtime]
# Model IDs per role. Swaps are config changes, not code changes.
SAHANA_GUARDRAIL_MODEL=openai/gpt-oss-20b                             # [optional][runtime]
SAHANA_ROUTER_MODEL=openai/gpt-oss-120b                               # [optional][runtime]
SAHANA_SYNTH_MODEL=google/gemini-2.5-flash                           # [optional][runtime]
SAHANA_LLM_TIMEOUT_SECONDS=30                                         # [optional][runtime]
SAHANA_LLM_MAX_RETRIES=3                                              # [optional][runtime]
SAHANA_LLM_STRUCTURED_REPAIR_ATTEMPTS=1                               # [optional][runtime]

# ── Tool paths: CRAG + Tavily (see ADR 0011) ───────────────────────────────────
SAHANA_RAG_TOP_K=4                                                    # [optional][runtime]
SAHANA_CRAG_GRADER_ROLE=guardrail                                     # [optional][runtime]
SAHANA_CRAG_MIN_RELEVANT=1                                            # [optional][runtime]
SAHANA_CRAG_CORRECTIVE_FALLBACK=true                                  # [optional][runtime]
SAHANA_RAG_SCORE_GATE_OPENAI=0.2                                      # [optional][runtime]
SAHANA_RAG_SCORE_GATE_LOCAL=0.3                                       # [optional][runtime]
# tavily_mode: live (real Tavily) | fake (deterministic, no network/key).
SAHANA_TAVILY_MODE=live                                               # [optional][runtime]
SAHANA_TAVILY_API_KEY=                                                # [required][runtime]
SAHANA_TAVILY_BASE_URL=https://api.tavily.com                         # [optional][runtime]
SAHANA_TAVILY_MAX_RESULTS=5                                           # [optional][runtime]
SAHANA_TAVILY_TIMEOUT_SECONDS=10                                      # [optional][runtime]
SAHANA_TAVILY_MAX_RETRIES=2                                           # [optional][runtime]

# ── Chat pipeline and short-term memory (see ADR 0012) ─────────────────────────
SAHANA_MEMORY_RECALL_TURNS=6                                          # [optional][runtime]
SAHANA_MEMORY_SUMMARY_THRESHOLD=12                                    # [optional][runtime]
SAHANA_SUMMARY_MODEL_ROLE=guardrail                                   # [optional][runtime]
SAHANA_CACHE_STORE_ENABLED=true                                       # [optional][runtime]
SAHANA_SSE_KEEPALIVE_SECONDS=15                                       # [optional][runtime]

# ── Supabase project references (declared; used by later tooling) ───────────────
SAHANA_SUPABASE_URL=                                                  # [optional][runtime]
SAHANA_SUPABASE_SERVICE_ROLE_KEY=                                     # [optional][runtime]
